{
  "version": 2,
  "public": true,
  "name": "axion-intelligence-platform",
  "framework": "nextjs",
  "buildCommand": "cd frontend && npm run build",
  "installCommand": "npm install",
  "outputDirectory": "frontend/.next",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://localhost:5000/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://axion-platform.vercel.app/api"
  },
  "analytics": true,
  "speedInsights": true,
  "cleanUrls": true,
  "trailingSlash": false
}
