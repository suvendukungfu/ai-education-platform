# ==============================================================================
# AXION INTELLIGENCE - UNIFIED ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (project/backend)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Database (Supabase/Neon/Local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/axion?schema=public"

# Authentication Secrets
JWT_ACCESS_SECRET="your-ultra-secure-access-secret-minimum-32-chars"
JWT_REFRESH_SECRET="your-ultra-secure-refresh-secret-minimum-32-chars"

# AI Engine Connection
AI_ENGINE_URL="http://localhost:8000"

# Redis (for Rate Limiting & Caching)
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (project/frontend)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# ------------------------------------------------------------------------------
# AI ENGINE CONFIGURATION (project/ai-engine)
# ------------------------------------------------------------------------------
OPENAI_API_KEY="sk-..."
MODEL_NAME="gpt-4-turbo"
